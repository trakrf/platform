# Backend Task Runner (TrakRF Platform)
# Uses fallback to inherit shared recipes from root justfile
set fallback := true

# Get database URLs from environment (loaded by direnv from .env.local)
#
# Two roles, matching CNPG and the local bootstrap (TRA-1075): pg_url_local is
# `trakrf-app`, which has CRUD and nothing else so RLS is evaluated against it;
# pg_url_migrate_local is `trakrf-migrate`, which owns the schema and is the
# only one of the two that can run DDL.
pg_url_local := env("PG_URL_LOCAL", "")
pg_url_migrate := env("PG_URL_MIGRATE", "")
pg_url_migrate_local := env("PG_URL_MIGRATE_LOCAL", "")
pg_url_cloud := env("PG_URL_CLOUD", "")

# List all available recipes
default:
    @just --list

# Start Go development server with hot reload (backend on host → postgres in docker)
dev:
    @echo "🚀 Backend on host → postgres in docker (localhost:5432)"
    @env PG_URL="{{pg_url_local}}" air

# Cloud development with hot reload (backend on host → postgres in cloud)
dev-cloud:
    @echo "☁️  Backend on host → cloud postgres"
    @env PG_URL="{{pg_url_cloud}}" air

# Run without hot reload (for debugging)
dev-no-reload:
    @echo "🚀 Backend on host → postgres in docker (no hot reload)"
    @go build -o ./tmp/main . && env PG_URL="{{pg_url_local}}" ./tmp/main

# Alias for consistency
run: dev

# Lint Go code (formatting + static analysis)
lint: check-rls-guard
    go fmt ./...
    go vet ./...

# Run backend tests with verbose output
test *args:
    #!/usr/bin/env bash
    if [ -z "{{args}}" ]; then
        go test -v ./...
    else
        go test -v {{args}}
    fi

# Run tests with the integration build tag (needs live Postgres)
# -p 1 serializes packages: they share the trakrf_test DB name, so running
# concurrently causes migration / schema collisions.
test-integration *args:
    go test -tags=integration -p 1 -v {{args}}

# TRA-671: Run Schemathesis contract tests against an ephemeral schemathesis DB.
# Stands up TimescaleDB if not running, migrates trakrf_schemathesis, loads the
# contract-test seed, starts the backend with APP_ENV=test, mints an API key via
# /test/apikeys, runs schemathesis, and tears down. Idempotent — safe to re-run.
#
# Notes:
#   - Backend listens on 8081 to avoid clobbering a developer's running dev backend.
#   - APP_ENV=test (any value != "production") mounts the test handler.
#   - With set -euo pipefail, a non-zero schemathesis exit (findings) will fail
#     the recipe. That's correct gate behavior — the report is still written to
#     backend/contract-tests/.
#   - Three roles, same split as every other environment (TRA-1075): postgres
#     creates the database and seeds it (the seed spans orgs, so it has to be
#     exempt from RLS), trakrf-migrate migrates, and the backend under test
#     serves as trakrf-app. Running the server under test as a superuser would
#     mean the contract suite never exercised a single policy.
test-contract:
    #!/usr/bin/env bash
    set -euo pipefail
    REPO_ROOT="$(git rev-parse --show-toplevel)"
    SCHEMA_DB="trakrf_schemathesis"
    PG_PASSWORD="${POSTGRES_PASSWORD:-postgres}"
    APP_ROLE="trakrf-app"
    MIGRATE_ROLE="trakrf-migrate"
    APP_PASSWORD="${PG_APP_PASSWORD:-trakrf-app}"
    MIGRATE_PASSWORD="${PG_MIGRATE_PASSWORD:-trakrf-migrate}"
    OBFUSCATION_KEY="${OBFUSCATION_KEY:-6f626675736361746f72746573746b657920303132333435363738396162636465}"
    # URL-encode passwords so chars like '#' don't get parsed as URL fragments
    urlenc() { python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"; }
    PG_PASSWORD_ENC="$(urlenc "$PG_PASSWORD")"
    APP_PASSWORD_ENC="$(urlenc "$APP_PASSWORD")"
    MIGRATE_PASSWORD_ENC="$(urlenc "$MIGRATE_PASSWORD")"
    PG_URL_ROOT="postgres://postgres:${PG_PASSWORD_ENC}@localhost:5432/postgres?sslmode=disable"
    # Superuser on the contract DB — used for seeding and for the bootstrap SQL.
    PG_URL_ADMIN_DB="postgres://postgres:${PG_PASSWORD_ENC}@localhost:5432/${SCHEMA_DB}?sslmode=disable"
    PG_URL_APP="postgres://${APP_ROLE}:${APP_PASSWORD_ENC}@localhost:5432/${SCHEMA_DB}?sslmode=disable"
    export PG_URL_MIGRATE_LOCAL="postgres://${MIGRATE_ROLE}:${MIGRATE_PASSWORD_ENC}@localhost:5432/${SCHEMA_DB}?sslmode=disable"

    cleanup() {
        if [ -n "${BACKEND_PID:-}" ]; then
            # go run spawns the compiled binary as a child — kill the child
            # (the actual listener) first, then the parent.
            pkill -P "$BACKEND_PID" 2>/dev/null || true
            kill "$BACKEND_PID" 2>/dev/null || true
        fi
    }
    trap cleanup EXIT

    # 1. Ensure timescaledb is up. Probe over the published TCP port from the
    # host — pg_isready inside the container can flip green a moment before
    # the docker port mapping starts accepting connections (CI cold-start race),
    # which would crash the first host-side psql call with "server closed the
    # connection unexpectedly".
    echo "🐳 Ensuring timescaledb is up..."
    docker compose -p platform -f "$REPO_ROOT/docker-compose.yaml" up -d timescaledb
    DB_READY=0
    for _ in {1..60}; do
        if PGPASSWORD="$PG_PASSWORD" psql -h localhost -p 5432 -U postgres -d postgres -c 'SELECT 1' >/dev/null 2>&1; then
            DB_READY=1
            break
        fi
        sleep 1
    done
    if [ "$DB_READY" -ne 1 ]; then
        echo "❌ timescaledb did not become ready within 60s" >&2
        exit 1
    fi

    # 2. (Re)create the contract-test DB with the same two-role shape as every
    # other environment (database/sql/, TRA-1075). Terminate any lingering
    # sessions first (e.g. an interrupted prior run) so DROP DATABASE doesn't
    # error, and drop before creating so the roles' grants land on a clean
    # schema.
    #
    # 02-schema.sql pins search_path and the obfuscation key at the database
    # level rather than on any connection URL, so migrate, backend and psql all
    # see the same path.
    echo "🗄  Recreating ${SCHEMA_DB}..."
    psql "$PG_URL_ROOT" -v ON_ERROR_STOP=1 -c \
        "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='${SCHEMA_DB}';" >/dev/null
    psql "$PG_URL_ROOT" -v ON_ERROR_STOP=1 -c "DROP DATABASE IF EXISTS ${SCHEMA_DB};"
    psql "$PG_URL_ROOT" -v ON_ERROR_STOP=1 -q \
        -v db_name="$SCHEMA_DB" \
        -v app_role="$APP_ROLE" -v app_password="$APP_PASSWORD" \
        -v migrate_role="$MIGRATE_ROLE" -v migrate_password="$MIGRATE_PASSWORD" \
        -f "$REPO_ROOT/database/sql/01-roles.sql"
    psql "$PG_URL_ADMIN_DB" -v ON_ERROR_STOP=1 -q \
        -v db_name="$SCHEMA_DB" \
        -v app_role="$APP_ROLE" -v migrate_role="$MIGRATE_ROLE" \
        -v obfuscation_key="$OBFUSCATION_KEY" \
        -f "$REPO_ROOT/database/sql/02-schema.sql"

    # 3. Migrate as trakrf-migrate (PG_URL_MIGRATE_LOCAL exported above,
    # re-evaluated by just migrate). The trakrf schema used to be pre-created
    # here so CURRENT_SCHEMA() would resolve to 'trakrf' and keep
    # schema_migrations in one place. `./server migrate` now creates the schema
    # and pins its ledger itself (TRA-1069); 02-schema.sql creates it only to
    # fix its owner and hang default privileges off it.
    echo "🔄 Migrating ${SCHEMA_DB}..."
    just migrate

    # 4. Seed as the superuser. The seed spans several orgs by design, so it
    # cannot run under the app role's policies.
    echo "🌱 Loading contract-test seed..."
    psql "$PG_URL_ADMIN_DB" -v ON_ERROR_STOP=1 -f "$REPO_ROOT/backend/database/seeds/contract_test_seed.sql"

    # 4a. Grant the app role CRUD on everything the migrations just created.
    # 02-schema.sql's default privileges already cover it; this is what makes
    # the recipe survive a database that was migrated before it was bootstrapped.
    psql "$PG_URL_ADMIN_DB" -v ON_ERROR_STOP=1 -q \
        -v app_role="$APP_ROLE" -f "$REPO_ROOT/database/sql/03-grants.sql"

    # 5. Start backend in background on port 8081, as the RLS-enforced app role
    if ss -lnt 'sport = :8081' 2>/dev/null | grep -q ":8081"; then
        echo "❌ Port 8081 already in use — stop the other listener and retry" >&2
        exit 1
    fi
    echo "🚀 Starting backend on :8081 with APP_ENV=test..."
    PG_URL="$PG_URL_APP" \
    APP_ENV=test \
    JWT_SECRET="${JWT_SECRET:-dev-secret-change-in-production}" \
    BACKEND_PORT=8081 \
        go run . >/tmp/trakrf-contract-backend.log 2>&1 &
    BACKEND_PID=$!

    # 6. Wait for /healthz
    echo "⏳ Waiting for /healthz..."
    READY=0
    for i in {1..60}; do
        if curl -sf http://localhost:8081/healthz > /dev/null 2>&1; then
            READY=1
            break
        fi
        sleep 1
    done
    if [ "$READY" -ne 1 ]; then
        echo "❌ Backend never became ready; tail of /tmp/trakrf-contract-backend.log:" >&2
        tail -50 /tmp/trakrf-contract-backend.log >&2 || true
        exit 1
    fi

    # 7. Mint API key
    echo "🔑 Minting contract-test API key..."
    KEY="$(curl -sf -X POST http://localhost:8081/test/apikeys \
        -H 'Content-Type: application/json' \
        -d '{"scopes":["assets:read","assets:write","locations:read","locations:write","tracking:read"]}' \
        | jq -r .token)"
    if [ -z "$KEY" ] || [ "$KEY" = "null" ]; then
        echo "❌ Failed to mint API key" >&2
        exit 1
    fi

    # 7a. Install Python deps for the TRA-692 deterministic FieldError-code
    # case runner + coverage gate. The .venv is gitignored alongside the
    # Schemathesis report artifacts.
    echo "🧪 Installing contract-test Python deps..."
    python3 -m venv "$REPO_ROOT/backend/contract-tests/.venv" >/dev/null
    PY="$REPO_ROOT/backend/contract-tests/.venv/bin/python"
    "$REPO_ROOT/backend/contract-tests/.venv/bin/pip" install -q -r "$REPO_ROOT/backend/contract-tests/requirements.txt"

    # 7b. Run deterministic FieldError-code cases against the server. Output:
    # backend/contract-tests/observed_codes.jsonl. The coverage gate at the
    # end of the recipe consumes this file. TRA-692.
    echo "🧪 Running deterministic FieldError-code cases (TRA-692)..."
    BASE_URL="http://localhost:8081" \
    API_KEY="$KEY" \
    OUT_DIR="$REPO_ROOT/backend/contract-tests" \
        "$PY" "$REPO_ROOT/backend/contract-tests/explicit_error_cases.py"

    # 7c. Run deterministic multi-step scenarios that Schemathesis can't
    # compose (cross-endpoint flows like "scan asset into location then DELETE
    # that location"). Closes the BB coverage gap that let the
    # CountActiveAssetsAtLocation guard regress silently for ~30 BB cycles
    # after TRA-734 nulled current_location_id. TRA-800.
    echo "🧪 Running deterministic multi-step scenarios (TRA-800)..."
    BASE_URL="http://localhost:8081" \
    API_KEY="$KEY" \
        "$PY" "$REPO_ROOT/backend/contract-tests/deterministic_scenarios.py"

    # 8. Run Schemathesis (docker, v4 CLI)
    #
    # The image runs as a non-root user; with a host bind mount the container
    # can't write report files unless we either chmod the host dir 0777 or
    # pin the container UID to the invoker. Pin --user to match: local devs
    # get reports owned by themselves, CI gets reports owned by the runner.
    echo "🧪 Running schemathesis..."
    mkdir -p "$REPO_ROOT/backend/contract-tests"
    chmod 0777 "$REPO_ROOT/backend/contract-tests"
    # Schemathesis exits non-zero when any *phase* shows ❌, which fires on
    # operation-level "Schema validation mismatch" warnings (operations that
    # 4xx most of their generated tests, e.g. DELETEs with FK-constrained
    # seed data) even when no individual test case actually failed
    # (TRA-678). The JUnit report is the truthful record of test outcomes;
    # if it lists zero failures/errors the run passes regardless of phase
    # status. `|| true` swallows the schemathesis exit and the JUnit guard
    # below restores hard-fail semantics on real findings.
    # TRA-681: `positive_data_acceptance` is disabled. The check enforces
    # "spec-compliant request must return 2xx/401/403/404/409/5xx" — i.e. a
    # 400 on a syntactically-valid body is always a failure. That model is
    # incompatible with two server-side semantic rules established in
    # design review:
    #
    #   * FK-existence (`fk_not_found`): a body that's spec-valid by shape
    #     can still reference an in-org row that does not exist. Industry
    #     precedent (Stripe, AWS, Atlassian) and the BB27 F2 design review
    #     pin this on 400 validation_error, not 409 — Schemathesis's
    #     accepted set explicitly excludes 400.
    #
    #   * Paired-key oneOf on GET filters: `?location_id=N&location_external_key=K`
    #     is spec-shaped (OpenAPI 3 can't encode query-param pair
    #     exclusivity) but server returns 400 ambiguous_fields per design.
    #
    # The POST-body oneOf case is encoded in the spec via
    # `not: required:[a,b]` (markMutuallyExclusiveFieldPairs) so the
    # generator no longer emits those payloads — that's the only one of
    # the three cases that *can* be expressed in the schema. The other
    # two need this check disabled to keep the gate honest.
    #
    # 2026-05-12 follow-up: `negative_data_rejection` is also disabled.
    # It fires false positives non-deterministically — same spec, same
    # backend, same Schemathesis version produces "API accepted
    # schema-violating request" on pull_request runs sometimes and not
    # others (caught on the first push-event run after PR #318 merged:
    # pull_request run on the identical tree passed, push-event run on
    # main produced 3 JUnit failures on /locations/{id}/ancestors,
    # /children, /descendants with `?offset=0`, an entirely
    # spec-compliant query).
    #
    # The check's failure_info reads: "Invalid component: in query —
    # violates `additionalProperties` at " with an empty path after
    # "at". That malformed message + non-reproducibility across runs
    # indicates a tooling bug, not a real spec drift. We've
    # corresponded the symmetric check (positive_data_acceptance) for
    # similar reasons; disabling negative_data_rejection makes the
    # gate's verdict stable across runs.
    #
    # Other checks (response_schema_conformance, not_a_server_error,
    # status_code_conformance, content_type_conformance,
    # response_headers_conformance, use_after_free,
    # ensure_resource_availability, ignored_auth, missing_required_header,
    # unsupported_method) remain on, so the meaningful regression-detection
    # signal is preserved.
    #
    # `--user "$(id -u):$(id -g)"` (so report files end up owned by the
    # host invoker / CI runner) leaves the container with no writable
    # home; the image's default `/app` cwd exposes that in two places:
    #
    #   * Hypothesis logs `HypothesisWarning: ... falling back to
    #     in-memory database` once per generated case
    #     (`/app/.hypothesis/examples` not writable).
    #   * TracecovHandler logs `PermissionError ... './schema-coverage.html'`
    #     at the end of the run when writing the optional coverage report.
    #
    # Both are non-fatal — Hypothesis works fine in memory and the
    # schema-coverage HTML is a nice-to-have we don't surface — but
    # together they bury the actual run output. Fixes:
    #
    #   * `-w /out` moves the container cwd to the mounted writable dir
    #     so the schema-coverage report writes cleanly alongside
    #     junit/har/ndjson rather than blowing up TracecovHandler.
    #   * `--tmpfs /app/.hypothesis` gives Hypothesis the writable cache
    #     directory it asks for. `--generation-deterministic` already
    #     means examples never persist across runs (the tmpfs evaporates
    #     with the container), but having the directory exist lets the
    #     library initialize cleanly instead of firing
    #     HypothesisWarning once per generated test case. We don't use
    #     `--generation-database=none` because Schemathesis rejects it
    #     with `--generation-deterministic` (the two flags express the
    #     same intent and are mutually exclusive at the CLI).
    docker run --rm --network host \
        --user "$(id -u):$(id -g)" \
        -w /out \
        --tmpfs /app/.hypothesis:uid=$(id -u),gid=$(id -g) \
        -v "$REPO_ROOT/docs/api/openapi.public.yaml:/spec.yaml:ro" \
        -v "$REPO_ROOT/backend/contract-tests:/out" \
        schemathesis/schemathesis:4.18.2 \
        run \
        --checks=all \
        --exclude-checks=positive_data_acceptance,negative_data_rejection \
        --warnings=off \
        --suppress-health-check=all \
        --generation-deterministic \
        --url http://localhost:8081 \
        --header "Authorization: Bearer ${KEY}" \
        --report=junit,har,ndjson \
        --report-dir=/out \
        /spec.yaml || true

    # Authoritative pass/fail: scan the latest JUnit for failures/errors.
    JUNIT="$(ls -t "$REPO_ROOT/backend/contract-tests"/junit-*.xml 2>/dev/null | head -1)"
    if [ -z "$JUNIT" ]; then
        echo "❌ schemathesis produced no JUnit report" >&2
        exit 1
    fi
    if grep -qE '<(failure|error) ' "$JUNIT"; then
        echo "❌ schemathesis JUnit reports failures/errors — see $JUNIT" >&2
        exit 1
    fi
    echo "✅ schemathesis: 0 failures, 0 errors (JUnit: $JUNIT)"

    # 10. FieldErrorCode enum coverage gate (TRA-692).
    # Asserts every value declared in components.schemas.FieldErrorCode.enum
    # was observed at least once during the explicit-cases run. Failure here
    # means the spec declares a code that no public surface emits (the BB30
    # §1.2 class-wide failure mode) — fix is either to wire emission, drop
    # the code from the enum, or add an explicit-cases probe if a probe was
    # missing.
    echo "🧪 Checking FieldErrorCode enum coverage (TRA-692)..."
    "$PY" "$REPO_ROOT/backend/contract-tests/check_field_error_coverage.py" \
        --spec "$REPO_ROOT/docs/api/openapi.public.yaml" \
        --observed "$REPO_ROOT/backend/contract-tests/observed_codes.jsonl"

# Run tests with race detection
test-race:
    go test -race ./...

# Run tests with coverage report
test-coverage:
    go test -cover ./...

# Resync vendor directory with go.mod
vendor:
    go mod vendor

# Build backend binary with version + build metadata injection (regenerates
# internal spec first). version, commit, tag, and build_time surface at /health
# so operators can tell which SHA is running — see TRA-481, TRA-485.
# Platform version (main.version) is derived from `git describe` so local
# builds report the same shape as CI builds; no hardcoded literal to drift.
build: api-spec
    #!/usr/bin/env bash
    set -euo pipefail
    COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
    TAG=$(git describe --tags --match 'v*' --always --dirty 2>/dev/null || echo "dev")
    APP_VERSION="${TAG}"
    BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    go build -ldflags "-X main.version=${APP_VERSION} -X main.commit=${COMMIT} -X main.tag=${TAG} -X main.buildTime=${BUILD_TIME}" -o bin/trakrf .

# Generate OpenAPI 3.0 specs (public → docs/api/ + embedded; internal → embedded only)
api-spec:
    @# swag's --parseDependency walks main.go, which has //go:embed frontend/dist.
    @# Without a real or stub file there, swag falls back to fully-qualified Go
    @# package names in schema definitions (~700 lines of churn). See TRA-505.
    @[ -e frontend/dist/index.html ] || (mkdir -p frontend/dist && touch frontend/dist/index.html)
    @echo "📚 Generating OpenAPI 3.0 specs..."
    swag init -g main.go --parseDependency --parseInternal -o docs
    @mkdir -p internal/handlers/swaggerspec ../docs/api
    go run ./internal/tools/apispec \
        --in docs/swagger.json \
        --public-out ../docs/api/openapi.public \
        --internal-out internal/handlers/swaggerspec/openapi.internal
    @cp ../docs/api/openapi.public.json internal/handlers/swaggerspec/openapi.public.json
    @cp ../docs/api/openapi.public.yaml internal/handlers/swaggerspec/openapi.public.yaml
    @echo "✅ Public spec:   docs/api/openapi.public.{json,yaml}  (committed) + swaggerspec/ (gitignored, embedded)"
    @echo "✅ Internal spec: backend/internal/handlers/swaggerspec/openapi.internal.{json,yaml}  (gitignored, embedded)"

# Legacy alias retained for muscle memory
swagger: api-spec

# Smoke test - verifies binary starts without panic (uses PG_URL_LOCAL for host → docker)
smoke-test:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔥 Running smoke test..."
    just build
    echo "Starting server with 5s timeout..."
    export PG_URL="{{pg_url_local}}"
    timeout 5s ./bin/trakrf > /tmp/trakrf-smoke.log 2>&1 & SERVER_PID=$!
    sleep 2
    echo "Testing /healthz endpoint..."
    if curl -f http://localhost:8080/healthz > /dev/null 2>&1; then
    echo "✅ Smoke test passed"
    kill $SERVER_PID 2>/dev/null || true
    else
    echo "❌ Smoke test failed"
    cat /tmp/trakrf-smoke.log
    kill $SERVER_PID 2>/dev/null || true
    exit 1
    fi

# Lint the public OpenAPI spec with Redocly CLI (uses pnpm). Mirrors CI:
# runs from the repo root so redocly auto-discovers ../redocly.yaml; the
# config there extends `recommended` and overrides repo-specific rules.
api-lint:
    cd .. && pnpm --package=@redocly/cli dlx redocly lint docs/api/openapi.public.yaml --extends=recommended

# TRA-455: Fail if pool.Query/Exec/Begin reappears in non-test storage code
# on RLS-protected tables. Coarse grep-based guard; a proper analyzer is a
# separate follow-up ticket.
#
# Scoped to the five RLS-protected storage files only — apikeys, organizations,
# users, invitations, etc. legitimately use raw pool (their tables are not
# RLS-protected). reports.go hits asset_scans (not RLS-protected). transactions.go
# defines WithOrgTx itself. *_test.go files may use raw pool for fixtures.
check-rls-guard:
    #!/usr/bin/env bash
    set -e
    RLS_FILES="internal/storage/assets.go internal/storage/locations.go internal/storage/inventory.go internal/storage/tags.go internal/storage/bulk_import_jobs.go internal/storage/reports.go internal/storage/scan_devices.go internal/storage/scan_points.go internal/storage/mustering.go"
    RESULT=$(grep -n 's\.pool\.\(Query\|Exec\|Begin\)' $RLS_FILES || true)
    FILTERED=$(echo "$RESULT" | grep -v '^$' || true)
    if [ -n "$FILTERED" ]; then
        echo "ERROR: s.pool.Query/Exec/Begin found in RLS-protected storage code. Wrap in WithOrgTx."
        echo "See TRA-455. Offenders:"
        echo "$FILTERED"
        exit 1
    fi
    echo "✓ check-rls-guard: clean"

# Run all backend validation checks
# Note: api-spec is NOT in this chain — swag's output depends on the local Go/swag
# build cache in ways that differ between dev machines and CI. The committed spec
# is whatever CI produces; local regeneration may legitimately diverge without
# indicating stale annotations. The drift check runs only in CI (api-spec.yml).
validate: api-lint lint test build smoke-test

# Shell access
shell:
    docker compose exec backend sh

# ============================================================================
# Database Migrations
# ============================================================================

# Run database migrations using the embedded set (./server migrate)
#
# Runs as trakrf-migrate, not trakrf-app: the app role has no CREATE anywhere,
# which is exactly what makes RLS meaningful for it (TRA-1075).
migrate:
    @echo "🔄 Running database migrations..."
    @env PG_URL="{{pg_url_migrate_local}}" go run . migrate
    @echo "✅ Migrations complete"

# Alias for consistency
migrate-up: migrate

# Roll back last migration
migrate-down:
    @echo "⏪ Rolling back last migration..."
    docker compose exec -e PG_URL="{{pg_url_migrate}}" backend sh -c 'migrate -path /app/migrations -database "$PG_URL" down 1'
    @echo "✅ Rollback complete"

# Show current migration version
migrate-status:
    @echo "📊 Migration status:"
    docker compose exec -e PG_URL="{{pg_url_migrate}}" backend sh -c 'migrate -path /app/migrations -database "$PG_URL" version'

# Create new migration file
migrate-create name:
    @echo "📝 Creating new migration: {{name}}"
    docker compose exec backend sh -c 'migrate create -ext sql -dir /app/migrations -seq {{name}}'

# Record the current migration files in migrations/checksums.txt (TRA-1077)
#
# Run this when you ADD a migration. The resulting diff should show new lines
# only — a changed hash on an existing line means an already-applied migration
# was edited, which no database will ever re-read. Add a forward migration
# instead of regenerating over it.
migrate-checksums:
    @go test ./migrations/ -run TestMigrationChecksums -update-checksums
    @echo "✅ migrations/checksums.txt updated — review the diff"

# Force migration to specific version (dangerous)
#
# Forcing stamps a version without applying anything, so it is also how a schema
# and its ledger drift apart (TRA-1069): confirm `just migrate-status` reports
# the version you expect before forcing, and prefer rebuilding a local database
# over forcing it into agreement.
migrate-force version:
    @echo "⚠️  Forcing migration version to {{version}}"
    docker compose exec -e PG_URL="{{pg_url_migrate}}" backend sh -c 'migrate -path /app/migrations -database "$PG_URL" force {{version}}'

# TRA-720: schema-diff between the legacy 44-migration stack (pre-tra-720 tag)
# and the new 10-file stack. Both are applied to ephemeral databases;
# pg_dump --schema-only outputs are diffed.
#
# Requires the pre-tra-720 git tag to exist (Task 13 Step 1 creates it).
# Requires PG_URL_LOCAL to be a Postgres URL pointing at the local docker DB,
# with sufficient privileges to CREATE/DROP databases.
#
# Usage: just backend db-diff-old-vs-new
db-diff-old-vs-new:
    #!/usr/bin/env bash
    set -euo pipefail
    REPO_ROOT="$(git rev-parse --show-toplevel)"
    OLD_DB="trakrf_diff_old"
    NEW_DB="trakrf_diff_new"
    LEGACY_WORKTREE="/tmp/tra-720-legacy-migrations"

    if ! git -C "$REPO_ROOT" rev-parse pre-tra-720 >/dev/null 2>&1; then
        echo "ERROR: pre-tra-720 tag not found. Create it: git tag pre-tra-720 <sha>" >&2
        exit 1
    fi

    # Derive per-DB URLs by string-replacing the dbname in PG_URL_LOCAL.
    # PG_URL_LOCAL format: postgres://user:pwd@host:port/<dbname>?<query>
    # Use sed -E with a host-anchored pattern so we don't accidentally
    # replace the username (which may equal the dbname, e.g. "postgres").
    OLD_URL=$(echo "$PG_URL_LOCAL" | sed -E "s|^(postgres://[^@]+@[^/]+/)[^?]+|\1${OLD_DB}|")
    NEW_URL=$(echo "$PG_URL_LOCAL" | sed -E "s|^(postgres://[^@]+@[^/]+/)[^?]+|\1${NEW_DB}|")

    psql "$PG_URL_LOCAL" -c "DROP DATABASE IF EXISTS $OLD_DB;"
    psql "$PG_URL_LOCAL" -c "DROP DATABASE IF EXISTS $NEW_DB;"
    psql "$PG_URL_LOCAL" -c "CREATE DATABASE $OLD_DB;"
    psql "$PG_URL_LOCAL" -c "CREATE DATABASE $NEW_DB;"
    psql "$PG_URL_LOCAL" -c "ALTER DATABASE $NEW_DB SET app.obfuscation_key = '6f626675736361746f72746573746b657920303132333435363738396162636465';"

    # Extract legacy migrations to a sibling worktree.
    rm -rf "$LEGACY_WORKTREE"
    git -C "$REPO_ROOT" worktree add --detach "$LEGACY_WORKTREE" pre-tra-720

    migrate -path "$LEGACY_WORKTREE/backend/migrations" -database "$OLD_URL" up
    migrate -path "$REPO_ROOT/backend/migrations" -database "$NEW_URL" up

    pg_dump --schema-only --no-owner --no-privileges -d "$OLD_URL" > /tmp/old_schema.sql
    pg_dump --schema-only --no-owner --no-privileges -d "$NEW_URL" > /tmp/new_schema.sql
    diff -u /tmp/old_schema.sql /tmp/new_schema.sql > /tmp/schema_diff.txt || true

    git -C "$REPO_ROOT" worktree remove --force "$LEGACY_WORKTREE"

    echo
    echo "Diff saved to /tmp/schema_diff.txt ($(wc -l < /tmp/schema_diff.txt) lines)"
    echo "Allowlist at $REPO_ROOT/backend/database/test/expected_diff_allowlist.txt"
    echo
    echo "Review the diff manually. Any line outside the allowlist categories is a regression."

# ============================================================================
# TRA-810: Natural-key FDW pull / cutover
# ============================================================================

# Natural-key FDW pull from source-url → target-url. Reusable beyond TRA-810
# (e.g., snapshot preview into local dev). Source must have the entity
# tables under `trakrf.*` with the canonical column names; target must be
# the TRA-720 v10 schema with `app.obfuscation_key` set. Surrogate IDs are
# regenerated by target triggers — works against pre- or post-TRA-720 sources.
#
# Flags:
#   --truncate    TRUNCATE target entity tables before pull (for local-dev-copy)
#
# Example:
#   just backend db-pull-nk "$PG_URL_PREVIEW" "$PG_URL_LOCAL" --truncate
db-pull-nk source-url target-url *flags='':
    #!/usr/bin/env bash
    set -euo pipefail
    SRC_URL="{{source-url}}"
    TGT_URL="{{target-url}}"
    FLAGS="{{flags}}"

    # Force search_path on every connection so the cutover SQL's unqualified
    # trakrf-schema references resolve. (The id trigger now reads a fully-
    # qualified trakrf.id_seq, so it no longer relies on this.)
    export PGOPTIONS='-c search_path=trakrf,public'

    SRC_HOST=$(python3 -c "import urllib.parse,sys;u=urllib.parse.urlparse(sys.argv[1]);print(u.hostname)" "$SRC_URL")
    SRC_PORT=$(python3 -c "import urllib.parse,sys;u=urllib.parse.urlparse(sys.argv[1]);print(u.port or 5432)" "$SRC_URL")
    SRC_DB=$(python3 -c   "import urllib.parse,sys;u=urllib.parse.urlparse(sys.argv[1]);print(u.path.lstrip('/'))" "$SRC_URL")
    SRC_USER=$(python3 -c "import urllib.parse,sys;u=urllib.parse.urlparse(sys.argv[1]);print(u.username)" "$SRC_URL")
    SRC_PW=$(python3 -c   "import urllib.parse,sys;u=urllib.parse.urlparse(sys.argv[1]);print(u.password)" "$SRC_URL")

    PSQL="psql $TGT_URL -v ON_ERROR_STOP=1 \
        -v src_host=$SRC_HOST -v src_port=$SRC_PORT -v src_db=$SRC_DB \
        -v src_user=$SRC_USER -v src_pw=$SRC_PW"

    if [[ "$FLAGS" == *--truncate* ]]; then
        echo "==> TRUNCATE target entity tables (--truncate flag)"
        $PSQL -f database/cutover/00_truncate_target.sql
    fi

    for f in database/cutover/[0-9][0-9]_*.sql; do
        # Skip the optional truncate file in the normal sequence — handled above.
        [[ "$f" == *00_truncate_target.sql ]] && continue
        echo "==> $f"
        $PSQL -f "$f"
    done

# TRA-810 alias — Cloud preview source, GKE preview CNPG target.
# Requires PG_URL_PREVIEW (source) and PG_URL_GKE_PREVIEW (target) in env.
cutover-preview:
    just db-pull-nk "$PG_URL_PREVIEW" "$PG_URL_GKE_PREVIEW"
