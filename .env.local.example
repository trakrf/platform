# =============================================================================
# ⚠️  SECURITY: This is a TEMPLATE - Replace all placeholder values
# Copy actual credentials from ../trakrf-web/.env.local
# NEVER commit .env.local to git (it's in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# MQTT Configuration (EMQX Cloud)
# -----------------------------------------------------------------------------
# MQTT protocol (mqtts for TLS)
MQTT_PROTO=mqtts

# EMQX Cloud hostname
MQTT_HOST=your-emqx-cloud-host.emqxsl.com

# EMQX Cloud port (8883 for TLS)
MQTT_PORT=8883

# MQTT username
MQTT_USER=your_mqtt_username

# MQTT password
MQTT_PASS=your_mqtt_password

# MQTT topic filter (# = wildcard)
MQTT_TOPIC="trakrf.id/#"

# Full MQTT connection URL (used by Redpanda Connect ingester)
# Note: Password must be URL-encoded
MQTT_URL=mqtts://user:your_url_encoded_pass@your-host.emqxsl.com:8883

# MQTT client ID (unique identifier for this connection)
MQTT_CLIENT_ID=trakrf-platform-ingester

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PARTS, NOT URLS.
#
# The cluster stores the pieces and interpolates them at the point of use —
# helm/trakrf-backend/templates/migrate-job.yaml builds
# `postgresql://$(PGUSER):$(PGPASSWORD)@host:port/db?sslmode=...` from a role
# name and a Secret, and never writes a DSN down. That arrived with the move to
# GKE/CNPG and was never ported back here; local dev kept four hand-written URLs
# and predates the trakrf-migrate / trakrf-app split entirely (TRA-1075).
#
# The cost of that gap was not theoretical. `PG_URL_MIGRATE_LOCAL` was added to
# this template by the role split and reached no actual .env.local, so
# `just backend migrate` could not run on any developer machine. It failed as
# "PG_URL environment variable not set" — two layers from the real cause — while
# a stale database went on serving a schema two migrations behind (TRA-1190).
#
# So: declare each value ONCE here, and let docker-compose.yaml and the
# justfiles assemble the connection strings. Each role password now appears a
# single time; the old template carried every one of them twice, raw and
# URL-encoded, and warned in a comment that you had to keep the copies in step.
#
# `just test-env-drift` checks these against database/justfile, which is what
# actually declares the database and role names.
#
# The local stack mirrors the CNPG shape used by preview and prod: a `trakrf`
# database owned by `trakrf-migrate`, served by `trakrf-app`.
#
# `trakrf-app` is not a superuser, has no BYPASSRLS and owns nothing, so
# row-level security is actually evaluated against it. That is the whole point:
# connecting as `postgres` means every policy goes untested until the code
# reaches a deployed environment. Do not "fix" a permission error by putting
# `postgres` back here — find the missing WithOrgTx or the missing grant.
#
# `just database init` (run automatically by `just database up`) creates the
# roles and the database from these values. Change them here, re-run it, and
# the roles are updated in place.

# The TimescaleDB container's own superuser and maintenance database. Consumed
# directly by the container and by `just database init`; not the app's.
# Raw password — no URL encoding, it never goes in a URL.
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=postgres

# Where the database answers. PG_HOST is the compose service name, used
# container-to-container; PG_HOST_LOCAL is the published port, used by anything
# running on the host (`just backend dev`, `just backend migrate`).
PG_HOST=timescaledb
PG_HOST_LOCAL=localhost
PG_PORT=5432
PG_SSLMODE=disable

# The application database and its two roles. These must match what
# database/justfile declares — it is the source, and `just test-env-drift`
# fails if these drift from it.
PG_DATABASE=trakrf

# The app role: CRUD only, so RLS is evaluated against it.
PG_APP_USER=trakrf-app
PG_APP_PASSWORD=trakrf-app

# The DDL role: owns the schema, and the only one of the two that can migrate.
PG_MIGRATE_USER=trakrf-migrate
PG_MIGRATE_PASSWORD=trakrf-migrate

# A password containing URL-reserved characters has to be encoded where it is
# interpolated into a URL: `#` becomes %23, `@` becomes %40. An unencoded `@` is
# the nasty one — it is the userinfo delimiter, so the URL silently reparses
# with part of the password as the hostname instead of failing. The local
# defaults above are deliberately boring so this never comes up.

# Surrogate-id Feistel master key (64 hex chars). Applied to the local database
# by `just database init`; without it every INSERT fails in the id trigger.
# This is the fixed dev/test key — deployed environments generate their own.
OBFUSCATION_KEY=6f626675736361746f72746573746b657920303132333435363738396162636465

# The one remaining whole DSN, and deliberately so: a superuser connection to
# the MAINTENANCE database, sharing no parts with the application. Only the
# integration test harness uses it, to CREATE DATABASE trakrf_test.
PG_ADMIN_URL=postgres://postgres:your_url_encoded_password@localhost:5432/postgres?sslmode=disable

# No `options=-c search_path=...` anywhere above. The migration runner sets its
# own path per-connection (ADR 0003) and `just database init` sets one on the
# database for everybody else, so the parameter has no remaining job locally.

# -----------------------------------------------------------------------------
# Backend: Auth
# -----------------------------------------------------------------------------
# Signing key for session JWTs. The backend refuses to boot on a known-weak
# value in a deployed environment (TRA-860); locally anything non-trivial does.
JWT_SECRET=dev-secret-change-in-production
# Session lifetime in seconds.
JWT_EXPIRATION=3600

# -----------------------------------------------------------------------------
# Backend: MQTT (EMQX Cloud - copy from ../trakrf-web/.env.local)
# -----------------------------------------------------------------------------
# MQTT protocol (mqtts for TLS)
MQTT_PROTO=mqtts

# EMQX Cloud hostname
MQTT_HOST=your-emqx-cloud-host.emqxsl.com

# EMQX Cloud port (8883 for TLS)
MQTT_PORT=8883

# MQTT username
MQTT_USER=your_mqtt_username

# MQTT password
MQTT_PASS=your_mqtt_password

# MQTT topic filter (# = wildcard)
MQTT_TOPIC=your_topic/#

# Full MQTT connection URL (used by Redpanda Connect ingester)
# Note: Password must be URL-encoded
MQTT_URL=mqtts://your_user:your_url_encoded_pass@your-host.emqxsl.com:8883

# MQTT client ID (unique identifier for this connection)
MQTT_CLIENT_ID=trakrf-platform-local

# -----------------------------------------------------------------------------
# Backend: Cloud DB (optional - for production cloud connection)
# -----------------------------------------------------------------------------
# Timescale Cloud connection URL (copy from ../trakrf-web/.env.local if using)
PG_URL_CLOUD=postgres://user:password@your-cloud-host.tsdb.cloud.timescale.com:12345/tsdb?sslmode=require&options=-c%20search_path%3Dtrakrf,public

# Preview Environment DB (Timescale Cloud - trakrf-preview service)
# Used for testing against Railway preview environment database
# Get actual credentials from secure source (not committed to git)
PG_URL_PREVIEW=postgres://tsdbadmin:your_preview_password@your-preview-host.tsdb.cloud.timescale.com:34826/tsdb?sslmode=require

# -----------------------------------------------------------------------------
# Backend Service
# -----------------------------------------------------------------------------
# HTTP server port
BACKEND_PORT=8080

# Backend log level (debug, info, warn, error)
BACKEND_LOG_LEVEL=info

# Email Configuration (Resend - for password reset emails)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# -----------------------------------------------------------------------------
# Frontend: VITE_* vars (exposed to browser)
# -----------------------------------------------------------------------------
# Backend API URL (optional, defaults to /api/v1)
# For development with backend on different host/port:
# VITE_API_URL=http://localhost:8080/api/v1
# For production, leave unset to use relative path /api/v1

# Application name
VITE_APP_NAME="TrakRF Platform"

# Application version for metadata
VITE_APP_VERSION=1.0.0

# Log level (fatal, error, warn, info, debug, trace, silly)
VITE_LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Frontend: RFID Configuration
# -----------------------------------------------------------------------------
# Default RF Power (dBm) - can be overridden in settings
VITE_DEFAULT_RF_POWER=30.0

# Default Session (0-3) - can be overridden in settings
VITE_DEFAULT_SESSION=1

# Connection timeout in milliseconds
VITE_CONNECTION_TIMEOUT=10000

# Inventory scan timeout in milliseconds
VITE_INVENTORY_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Frontend: Development Settings
# -----------------------------------------------------------------------------
# Enable debug features in development
VITE_ENABLE_DEBUG_PANEL=true

# Mock device for development (when no real CS108 available)
VITE_MOCK_DEVICE=false

# Enable BLE mock mode (true = no hardware needed)
VITE_BLE_MOCK_ENABLED=true

# Enable performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=false

# -----------------------------------------------------------------------------
# Frontend: Environment Identification
# -----------------------------------------------------------------------------
# Environment indicator shown in UI banner and page title
# Values: dev, staging, prod (or empty)
# - dev: Orange banner, [DEV] title prefix
# - staging: Purple banner, [STG] title prefix
# - prod or empty: No banner (clean production UI)
# VITE_ENVIRONMENT=dev

# -----------------------------------------------------------------------------
# Frontend: Feature Flags
# -----------------------------------------------------------------------------
# Enable barcode scanning features
VITE_ENABLE_BARCODE=true

# Enable locate features
VITE_ENABLE_TAG_SEARCH=true

# Enable reconciliation features
VITE_ENABLE_RECONCILIATION=true

# Enable dark mode by default
VITE_DEFAULT_DARK_MODE=true

# -----------------------------------------------------------------------------
# Frontend: BLE Bridge Configuration (ble-mcp-test)
# -----------------------------------------------------------------------------
# Bridge server host (adjust to your bridge server IP for E2E tests)
BLE_MCP_HOST=localhost

# Bridge server WebSocket port. REQUIRED — there is no default, deliberately.
#
# This was 8080 until TRA-1179. The platform backend publishes on 0.0.0.0:8080,
# which subsumes loopback, so the bridge and the backend could never run at the
# same time — and the @hardware e2e suite needs BOTH (backend to authenticate,
# bridge to reach the CS108). That suite could not have passed on a co-located
# host no matter what it asserted.
#
# It went unnoticed because the bridge used to run on a separate box; two hosts
# meant two independent 8080s. Co-locating it landed it on the backend's port.
#
# 25153 is deliberately clear of both the 808x and 605x bands (6053 is ESPHome's
# assigned port, so adjacency would imply a vendor sub-service that does not
# exist), and sits below this host's ephemeral range (32768-60999) so it can
# never collide with an outbound source port. Mnemonic: 25 + ESPHome's 153.
#
# It is also clear of the crowded alternate-HTTP clusters (8080/8443/9000/9090/
# 10000/18080/28080) and of 30000-32767, which Kubernetes NodePorts use.
#
# An earlier pick of 15104 was rejected on REPUTATION rather than collision:
# 15104 was the mstream DDoS handler-to-client port, and IDS/IPS products still
# ship signatures for it. Nothing uses it today, but traffic there can be
# flagged as suspicious -- a failure that surfaces as unexplained scanner noise
# and is miserable to trace back to a port choice. A quiet port and a port with
# no history are different things.
BLE_MCP_WS_PORT=25153

# BLE_MCP_HTTP_PORT and BLE_MCP_HTTP_TOKEN were deleted by TRA-1161: the MCP
# server is a unix socket now, reached by a stdio shim, and 0600 on the socket
# file replaces the token. Nothing reads either variable. They survived here
# after TRA-1177 removed them from the live config because the guard in
# no-dead-http-config.test.ts is rooted at frontend/ and never saw this file.

# Bridge server log level
BLE_MCP_LOG_LEVEL=info

# CS108 Device name filter
BLE_DEVICE_NAME=CS108

# Optional: Override auto-generated session ID
# BLE_SESSION_ID=my-custom-session

# Note: The bridge URL is built automatically from components:
# WebSocket URL = ws://${BLE_MCP_HOST}:${BLE_MCP_WS_PORT}

# -----------------------------------------------------------------------------
# Frontend: OpenReplay Session Replay (optional)
# -----------------------------------------------------------------------------
# Enable OpenReplay session recording
VITE_OPENREPLAY_ENABLED=false

# OpenReplay project key (get from OpenReplay dashboard at app.openreplay.com)
# VITE_OPENREPLAY_PROJECT_KEY=your_project_key_here

# OpenReplay ingest endpoint (only needed for self-hosted, not for cloud version)
# VITE_OPENREPLAY_INGEST_POINT=https://openreplay.your-domain.com/ingest

# Allow insecure mode for local development (only set to true for localhost)
# VITE_OPENREPLAY_INSECURE=false

# -----------------------------------------------------------------------------
# Frontend: E2E Testing Timeouts (milliseconds)
# -----------------------------------------------------------------------------
BRIDGE_CONNECT_TIMEOUT=5000
BRIDGE_COMMAND_TIMEOUT=2000
BRIDGE_UI_TIMEOUT=3000
BRIDGE_SCAN_TIMEOUT=10000

# -----------------------------------------------------------------------------
# GitHub Integration (optional)
# -----------------------------------------------------------------------------
# GitHub token for PR and push activity
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Infra Ops Passthrough (optional)
# -----------------------------------------------------------------------------
# Path to your trakrf/infra checkout, used by `just ops`, `just psql` and
# `just logs` to forward to infra's ops recipes. Only needed if your infra
# checkout is not a sibling directory named `infra` next to this one.
# TRAKRF_INFRA_DIR=/home/you/trakrf-infra

# -----------------------------------------------------------------------------
# Twilio SMS (optional; server-side only)
# -----------------------------------------------------------------------------
# Keep the credentials empty until Twilio is intentionally configured. To keep
# Twilio fully disabled, also clear the example public URL below. See
# docs/operations/twilio-application-integration.md before configuring it.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PUBLIC_BASE_URL=https://api.example.com
