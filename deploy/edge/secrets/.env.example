# Postgres (local Timescale container).
#
# POSTGRES_PASSWORD is the superuser, used only by db-init.sh, pg_dump and
# psql. The stack itself never connects as postgres: a superuser bypasses
# row-level security, so every policy would go unevaluated on this box
# (TRA-1075). PG_URL is the app role — CRUD only, owns nothing.
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=postgres
# Role passwords consumed by db-init.sh; must match the URLs below and in
# migrate.env. URL-encode any special characters in the URL copy.
PG_APP_PASSWORD=CHANGEME
PG_MIGRATE_PASSWORD=CHANGEME
# No options=-c search_path=: db-init.sh sets it on the database itself, and
# the migration runner sets its own per connection (ADR 0003).
PG_URL=postgres://trakrf-app:CHANGEME@timescaledb:5432/trakrf?sslmode=disable
# MQTT (local Mosquitto, basic auth) — password must match mosquitto/passwd
MQTT_URL=mqtt://trakrf-mqtt:CHANGEME@mosquitto:1883
# MQTT_TOPIC retired (TRA-922): the subscriber subscribes to exactly the
# registered publish_topics (data-driven), so there is no static filter to set.
MQTT_CLIENT_ID=trakrf-demo-box
# Backend
JWT_SECRET=CHANGEME
JWT_EXPIRATION=3600
BACKEND_PORT=8080
BACKEND_LOG_LEVEL=info
# Surrogate-id Feistel master key (64 hex chars) — set on the DB at init
OBFUSCATION_KEY=CHANGEME
# Banner label shown in the app header (non-prod -> purple banner). Empty/prod = none.
ENVIRONMENT_LABEL=Demo
