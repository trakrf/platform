# PG_URL override for the migrate unit only (TRA-1075).
#
# migrate.container loads /srv/trakrf/secrets/.env first and then this file, so
# the PG_URL here wins for that one unit. Migrations need DDL, which the app
# role deliberately does not have — that is what makes row-level security
# meaningful for the backend.
#
# Password must match PG_MIGRATE_PASSWORD in .env (URL-encode special
# characters here).
PG_URL=postgres://trakrf-migrate:CHANGEME@timescaledb:5432/trakrf?sslmode=disable
